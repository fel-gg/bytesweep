#!/usr/bin/env python3
"""Native Linux process page-out helper for Reduce Memory.

Uses pidfd_open(2) and process_madvise(2) with MADV_PAGEOUT. The helper never
kills a process and never changes the contents or layout of a mapping.
"""

from __future__ import annotations

import argparse
import ctypes
import errno
import os
import platform
import re
import stat
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable


MADV_PAGEOUT = 21
SYS_PIDFD_OPEN = 434
SYS_PROCESS_MADVISE = 440
MAX_PROCESS_MADVISE_IOVECS = 64
SUPPORTED_ARCHITECTURES = {
    "x86_64",
    "amd64",
    "aarch64",
    "arm64",
    "i386",
    "i486",
    "i586",
    "i686",
    "armv7l",
    "riscv64",
    "ppc64le",
    "s390x",
}

SYSTEM_PROTECTED_NAMES = {
    "accounts-daemon",
    "avahi-daemon",
    "chronyd",
    "colord",
    "cron",
    "crond",
    "systemd",
    "init",
    "sshd",
    "dbus-broker",
    "systemd-journald",
    "systemd-udevd",
    "systemd-logind",
    "systemd-network",
    "systemd-resolve",
    "systemd-timesyncd",
    "dbus-daemon",
    "networkmanager",
    "polkitd",
    "rsyslogd",
    "rtkit-daemon",
    "wpa_supplicant",
    "containerd",
    "dockerd",
}

MAP_HEADER = re.compile(
    r"^([0-9a-fA-F]+)-([0-9a-fA-F]+)\s+([rwxps-]{4})\s+"
    r"[0-9a-fA-F]+\s+\S+\s+\d+(?:\s+(.*))?$"
)


class IOVec(ctypes.Structure):
    _fields_ = [("iov_base", ctypes.c_void_p), ("iov_len", ctypes.c_size_t)]


LIBC = ctypes.CDLL(None, use_errno=True) if platform.system() == "Linux" else None
if LIBC is not None:
    LIBC.syscall.restype = ctypes.c_long


